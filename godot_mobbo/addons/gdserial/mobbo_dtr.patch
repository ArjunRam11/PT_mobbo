+    /// MoBBo patch: drive the DTR line of an open port.
+    #[func]
+    pub fn set_dtr(&self, port_name: GString, level: bool) -> bool {
+        let Some(port_arc) = self.ports.lock().ok().and_then(|m| m.get(&port_name.to_string()).cloned()) else {
+            godot_error!("Port not open: {}", port_name);
+            return false;
+        };
+        let result = match port_arc.lock() {
+            Ok(mut port) => port.write_data_terminal_ready(level),
+            Err(_) => return false,
+        };
+        if let Err(e) = result {
+            godot_error!("Failed to set DTR on {}: {}", port_name, e);
+            return false;
+        }
+        true
+    }
+
+    /// MoBBo patch: drive the RTS line of an open port.
+    #[func]
+    pub fn set_rts(&self, port_name: GString, level: bool) -> bool {
+        let Some(port_arc) = self.ports.lock().ok().and_then(|m| m.get(&port_name.to_string()).cloned()) else {
+            godot_error!("Port not open: {}", port_name);
+            return false;
+        };
+        let result = match port_arc.lock() {
+            Ok(mut port) => port.write_request_to_send(level),
+            Err(_) => return false,
+        };
+        if let Err(e) = result {
+            godot_error!("Failed to set RTS on {}: {}", port_name, e);
+            return false;
+        }
+        true
+    }
