extends Node
## Autoload "Sfx": sound effects, per-game music and continuous loops.
##
##   Sfx.play("coin")               one-shot effect (pooled, overlaps fine)
##   Sfx.play_music("music_coin")   looping background music (fades in)
##   Sfx.stop_music()               fades out
##   Sfx.set_loop("roll", 0..1)     continuous loop, volume by amount (0 = silent)
##   Sfx.stop_loop("roll")
##
## Sounds are res://sounds/<name>.wav, generated by tools/make_sounds.py.
## Missing files are ignored silently (a game never breaks over audio).
## Settings: sound_on / music_on, saved to user://sound.cfg; the M key
## toggles all sound. Purely presentational -- no game state lives here.

signal settings_changed

const SOUND_DIR := "res://sounds/"
const SETTINGS_PATH := "user://sound.cfg"
const POOL_SIZE := 10
const MUSIC_DB := -15.0
const SFX_DB := -4.0

var sound_on := true
var music_on := true

var _pool: Array[AudioStreamPlayer] = []
var _next := 0
var _music: AudioStreamPlayer
var _music_name := ""
var _music_tween: Tween
var _loops := {}       # name -> AudioStreamPlayer
var _cache := {}
var _last_played := {} # name -> msec, to stop machine-gun repeats

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_pool.append(p)
	_music = AudioStreamPlayer.new()
	_music.volume_db = -80.0
	add_child(_music)
	_load_settings()

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_M:
		set_sound_on(not sound_on)
		get_viewport().set_input_as_handled()

# -- One-shots -------------------------------------------------------------------

func play(sound_name: String, volume_db: float = 0.0, pitch: float = 1.0, min_gap_ms: int = 30) -> void:
	if not sound_on:
		return
	var now := Time.get_ticks_msec()
	if now - int(_last_played.get(sound_name, -100000)) < min_gap_ms:
		return
	var stream := _stream(sound_name)
	if stream == null:
		return
	_last_played[sound_name] = now
	var p := _pool[_next]
	_next = (_next + 1) % POOL_SIZE
	p.stream = stream
	p.volume_db = SFX_DB + volume_db
	p.pitch_scale = pitch
	p.play()

# -- Music -----------------------------------------------------------------------

func play_music(music_name: String) -> void:
	_music_name = music_name
	if not music_on or not sound_on:
		return
	var stream := _stream(music_name, true)
	if stream == null:
		return
	if _music.playing and _music.stream == stream:
		_fade_music(MUSIC_DB)
		return
	_music.stream = stream
	_music.volume_db = -40.0
	_music.play()
	_fade_music(MUSIC_DB, 1.2)

func stop_music() -> void:
	_music_name = ""
	_fade_music(-60.0, 0.6, true)

func _fade_music(target_db: float, time: float = 0.6, stop_after: bool = false) -> void:
	if _music_tween != null:
		_music_tween.kill()
	if not _music.playing:
		return
	_music_tween = create_tween()
	_music_tween.tween_property(_music, "volume_db", target_db, time)
	if stop_after:
		_music_tween.tween_callback(_music.stop)

# -- Continuous loops --------------------------------------------------------------

## amount 0..1 maps to silent..full; the loop keeps running quietly at 0 so
## it doesn't restart (click) on every small motion.
func set_loop(loop_name: String, amount: float, max_db: float = -6.0) -> void:
	var p: AudioStreamPlayer = _loops.get(loop_name)
	if p == null:
		var stream := _stream(loop_name, true)
		if stream == null:
			return
		p = AudioStreamPlayer.new()
		p.stream = stream
		add_child(p)
		_loops[loop_name] = p
	amount = clampf(amount, 0.0, 1.0)
	if not sound_on or amount <= 0.001:
		p.volume_db = -80.0
	else:
		p.volume_db = lerpf(-40.0, max_db, sqrt(amount))
		p.pitch_scale = 0.8 + 0.5 * amount
	if not p.playing:
		p.play()

func stop_loop(loop_name: String) -> void:
	var p: AudioStreamPlayer = _loops.get(loop_name)
	if p != null:
		p.stop()

# -- Settings --------------------------------------------------------------------

func set_sound_on(on: bool) -> void:
	sound_on = on
	if not on:
		_music.stop()
		for p in _loops.values():
			p.volume_db = -80.0
	elif _music_name != "":
		play_music(_music_name)
	_save_settings()
	settings_changed.emit()

func set_music_on(on: bool) -> void:
	music_on = on
	if not on:
		_music.stop()
	elif _music_name != "":
		play_music(_music_name)
	_save_settings()
	settings_changed.emit()

func _load_settings() -> void:
	var cfg := ConfigFile.new()
	if cfg.load(SETTINGS_PATH) == OK:
		sound_on = cfg.get_value("sound", "sound_on", true)
		music_on = cfg.get_value("sound", "music_on", true)

func _save_settings() -> void:
	var cfg := ConfigFile.new()
	cfg.set_value("sound", "sound_on", sound_on)
	cfg.set_value("sound", "music_on", music_on)
	cfg.save(SETTINGS_PATH)

# -- Loading ---------------------------------------------------------------------

func _stream(sound_name: String, looped: bool = false) -> AudioStream:
	if not _cache.has(sound_name):
		var path := SOUND_DIR + sound_name + ".wav"
		var s: AudioStream = load(path) if ResourceLoader.exists(path) else null
		# Belt and braces: the WAVs carry a loop chunk, but force looping in
		# case an import setting overrode it.
		if looped and s is AudioStreamWAV and s.loop_mode == AudioStreamWAV.LOOP_DISABLED:
			var w := s as AudioStreamWAV
			w.loop_mode = AudioStreamWAV.LOOP_FORWARD
			w.loop_begin = 0
			w.loop_end = w.data.size() / 2  # 16-bit mono
		_cache[sound_name] = s
	return _cache[sound_name]
